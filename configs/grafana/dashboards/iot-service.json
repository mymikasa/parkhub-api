  "panels": [
    {
      "title": "SendCode Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_call_duration_seconds_count{job=\"parkhub-iot\",rpc_method=~\"parkhub.iot.v1.IoTService/.*\"}[1m])) by (rpc_method, rpc_response_status_code)",
          "legendFormat": "{{rpc_method}} {{rpc_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "title": "SendCode Duration p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(rpc_server_call_duration_seconds_bucket{job=\"parkhub-iot\"}[1m])) by (le, rpc_method))", "legendFormat": "p50 {{rpc_method}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(rpc_server_call_duration_seconds_bucket{job=\"parkhub-iot\"}[1m])) by (le, rpc_method))", "legendFormat": "p95 {{rpc_method}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(rpc_server_call_duration_seconds_bucket{job=\"parkhub-iot\"}[1m])) by (le, rpc_method))", "legendFormat": "p99 {{rpc_method}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum(rate(rpc_server_call_duration_seconds_count{job=\"parkhub-iot\",rpc_response_status_code!=\"OK\"}[1m])) by (rpc_method) / sum(rate(rpc_server_call_duration_seconds_count{job=\"parkhub-iot\"}[1m])) by (rpc_method)",
          "legendFormat": "{{rpc_method}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      }
    },
    {
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "go_goroutine_count{job=\"parkhub-iot\"}", "legendFormat": "goroutines" }
      ]
    },
    {
      "title": "Memory Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "go_memory_used_bytes{job=\"parkhub-iot\"}", "legendFormat": "{{go_memory_type}}" },
        { "expr": "go_memory_gc_goal_bytes{job=\"parkhub-iot\"}", "legendFormat": "gc goal" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
